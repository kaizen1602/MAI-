{
  "name": "Análisis PDF Corabastos Simplificado",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "analizar-pdf",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "pdf-corabastos"
    },
    {
      "parameters": {
        "mode": "jsonToBinary",
        "options": {
          "fileName": "corabastos.pdf",
          "mimeType": "application/pdf"
        }
      },
      "id": "2",
      "name": "Convertir a Binario",
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "toText"
      },
      "id": "3",
      "name": "PDF a Texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "text",
        "operation": "message",
        "modelId": "gpt-4o",
        "prompt": "=Eres un experto extrayendo datos de boletines de precios. Extrae TODOS los productos del siguiente documento de Corabastos.\n\nPara cada producto extrae:\n- nombre: nombre exacto del producto\n- categoria: (Pollo, Pescados, Granos, Platanos, Tuberculos, Frutas, Hortalizas, Carnicos, Huevos, Lacteos)\n- precio_extra: precio calidad extra (solo número)\n- precio_primera: precio calidad primera (solo número)  \n- precio_unidad: precio por unidad (solo número)\n- presentacion: tipo de presentación\n- cantidad: cantidad numérica\n- unidad_medida: unidad de medida\n- variacion: (Estable, Subio, Bajo)\n\nDevuelve SOLO un JSON válido con esta estructura:\n{\n  \"fecha\": \"2025-10-14\",\n  \"productos\": [\n    {\n      \"nombre\": \"PRODUCTO\",\n      \"categoria\": \"CATEGORIA\",\n      \"precio_extra\": 15000,\n      \"precio_primera\": 14000,\n      \"precio_unidad\": 15000,\n      \"presentacion\": \"KILO\",\n      \"cantidad\": 1,\n      \"unidad_medida\": \"KILO\",\n      \"variacion\": \"Estable\"\n    }\n  ]\n}\n\nDOCUMENTO:\n{{ $json.text }}",
        "options": {
          "temperature": 0.1,
          "maxTokens": 4000
        }
      },
      "id": "4",
      "name": "OpenAI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = [];\n\ntry {\n  // Obtener respuesta de OpenAI\n  let response = $input.first().json.message.content;\n  \n  // Limpiar markdown si existe\n  response = response.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  \n  // Parsear JSON\n  const data = JSON.parse(response);\n  const fecha = data.fecha || new Date().toISOString().split('T')[0];\n  \n  // Crear un item por cada producto\n  for (const producto of data.productos) {\n    items.push({\n      json: {\n        nombre: producto.nombre || '',\n        categoria: producto.categoria || '',\n        precio_extra: Number(producto.precio_extra) || 0,\n        precio_primera: Number(producto.precio_primera) || 0,\n        precio_unidad: Number(producto.precio_unidad) || 0,\n        presentacion: producto.presentacion || '',\n        cantidad: Number(producto.cantidad) || 0,\n        unidad_medida: producto.unidad_medida || '',\n        variacion: producto.variacion || 'Estable',\n        fecha_registro: fecha,\n        fecha_creacion: new Date().toISOString()\n      }\n    });\n  }\n  \n  console.log(`✅ ${items.length} productos procesados`);\n  \n} catch (error) {\n  console.error('❌ Error:', error.message);\n  throw new Error(`Error procesando datos: ${error.message}`);\n}\n\nreturn items;"
      },
      "id": "5",
      "name": "Procesar JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "precios_corabastos",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "nombre": "={{ $json.nombre }}",
            "categoria": "={{ $json.categoria }}",
            "precio_extra": "={{ $json.precio_extra }}",
            "precio_primera": "={{ $json.precio_primera }}",
            "precio_unidad": "={{ $json.precio_unidad }}",
            "presentacion": "={{ $json.presentacion }}",
            "cantidad": "={{ $json.cantidad }}",
            "unidad_medida": "={{ $json.unidad_medida }}",
            "variacion": "={{ $json.variacion }}",
            "fecha_registro": "={{ $json.fecha_registro }}",
            "fecha_creacion": "={{ $json.fecha_creacion }}"
          }
        }
      },
      "id": "6",
      "name": "MySQL",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"success\": true,\n  \"registros\": $items().length,\n  \"mensaje\": \"Productos guardados correctamente\"\n} }}"
      },
      "id": "7",
      "name": "Respuesta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "jsCode": "// Capturar error y preparar respuesta\nconst error = $input.first().json;\n\nreturn [{\n  json: {\n    success: false,\n    error: error.message || 'Error desconocido',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "8",
      "name": "Manejar Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 500]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "logs_errores",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "tipo_error": "procesamiento_pdf",
            "mensaje_error": "={{ $json.error }}",
            "datos_contexto": "={{ JSON.stringify($json) }}",
            "fecha_error": "={{ $json.timestamp }}"
          }
        }
      },
      "id": "9",
      "name": "Log Error MySQL",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.4,
      "position": [1340, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "responseCode": 500
      },
      "id": "10",
      "name": "Respuesta Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 500]
    }
  ],
